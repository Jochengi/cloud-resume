# =========================================================================
# 1. TERRAFORM INFRASTRUCTURE (CRITICAL SECURITY & PERFORMANCE)
# =========================================================================
# Local directory containing compiled cloud provider binaries (~650MB+)
.terraform/
**/.terraform/

# Hide local state history files (These contain raw account metadata)
*.tfstate
*.tfstate.*

# Crash logs and CLI configuration files
crash.log
crash.*.log
*.tfvars
*.tfvars.json
override.tf
override.tf.json
_override.tf
_override.tf.json
.terraformrc
terraform.rc

# =========================================================================
# 2. PYTHON BACKEND WORKSPACE
# =========================================================================
# Isolated virtual environment sandboxes
venv/
.venv/
env/
ENV/

# Compiled Python bytecode caching fragments
**/__pycache__/
*.py[cod]
*$py.class

# Local zip deployment packaging packages
backend/lambdas/*.zip

# =========================================================================
# 3. JAVASCRIPT / REACT FRONTEND
# =========================================================================
# Local external package library downloads
node_modules/
**/node_modules/

# Production build application compile outputs
dist/
build/

# Local diagnostic logging files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local environment configuration variable storage sheets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# =========================================================================
# 4. OPERATING SYSTEM JUNKS
# =========================================================================
.DS_Store
Thumbs.db
